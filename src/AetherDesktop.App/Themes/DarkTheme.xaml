<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#121826" />
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#1C2433" />
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#1B2333" />
    <SolidColorBrush x:Key="PrimaryAccentBrush" Color="#7EA9FF" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F3F5F9" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#A3B0C9" />

    <Style x:Key="SidebarButtonStyle" TargetType="Button">
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="#D9E3FF" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Cursor" Value="Hand" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#2B3A56" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#324B74" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="#7EA9FF" />
        <Setter Property="Foreground" Value="#0B1020" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#96BBFF" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
