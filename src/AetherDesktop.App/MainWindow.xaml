<Window x:Class="AetherDesktop.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aether Desktop"
        Width="1280"
        Height="760"
        MinWidth="960"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="#121826">
    <Grid>
        <Border x:Name="WallpaperBackground" Background="#121826" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#1B2333" Padding="18" Opacity="0.96">
                <StackPanel>
                    <TextBlock Text="AETHER" Foreground="#EDEFF8" FontSize="24" FontWeight="Bold" Margin="0,0,0,18" />

                    <Button x:Name="LibraryButton" Content="Library" Style="{StaticResource SidebarButtonStyle}" Click="SidebarButton_Click" Tag="Library" />
                    <Button x:Name="InstalledButton" Content="Installed" Style="{StaticResource SidebarButtonStyle}" Click="SidebarButton_Click" Tag="Installed" />
                    <Button x:Name="FavoritesButton" Content="Favorites" Style="{StaticResource SidebarButtonStyle}" Click="SidebarButton_Click" Tag="Favorites" />
                    <Button x:Name="PlaylistsButton" Content="Playlists" Style="{StaticResource SidebarButtonStyle}" Click="SidebarButton_Click" Tag="Playlists" />
                    <Button x:Name="DisplaysButton" Content="Displays" Style="{StaticResource SidebarButtonStyle}" Click="SidebarButton_Click" Tag="Displays" />
                    <Button x:Name="SettingsButton" Content="Settings" Style="{StaticResource SidebarButtonStyle}" Click="SidebarButton_Click" Tag="Settings" />
                    <Button x:Name="ImportButton" Content="Import" Style="{StaticResource SidebarButtonStyle}" Click="SidebarButton_Click" Tag="Import" />
                </StackPanel>
            </Border>

            <Grid Grid.Column="1" Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="SearchTextBox" Grid.Column="0" Height="36" Margin="0,0,12,0" TextChanged="SearchTextBox_TextChanged" />
                    <Button Grid.Column="1" Width="160" Content="Open Library Folder" Style="{StaticResource PrimaryButtonStyle}" Click="OpenLibraryFolder_Click" />
                </Grid>

                <Border Grid.Row="1" Margin="0,18,0,0" Background="#1F2A3F" CornerRadius="12" Padding="16" Opacity="0.96">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Now playing: " Foreground="#A8B5CF" FontSize="14" />
                        <TextBlock x:Name="NowPlayingText" Foreground="#F0F4FF" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text=" • 1080p • 4K ready" Foreground="#8CA7D9" Margin="12,0,0,0" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <Grid Grid.Row="2" Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#1C2433" CornerRadius="14" Padding="18" Opacity="0.96">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock x:Name="LibraryHeaderText" Grid.Row="0" Text="Wallpaper library" Foreground="#F4F6FA" FontWeight="SemiBold" FontSize="22" Margin="0,0,0,18" />

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="WallpaperItemsControl">
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Margin" Value="0,0,12,12" />
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="180" Height="120" Background="#2A3548" CornerRadius="10" Padding="8" Cursor="Hand" MouseLeftButtonDown="WallpaperCard_Click">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="BorderBrush" Value="Transparent" />
                                                        <Setter Property="BorderThickness" Value="2" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="BorderBrush" Value="#7EA9FF" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <Border Background="#1C2433" CornerRadius="8" Opacity="0.8" />
                                                    <TextBlock Grid.Row="1"
                                                               Text="{Binding Title}"
                                                               Foreground="#F4F6FA"
                                                               FontSize="12"
                                                               TextTrimming="CharacterEllipsis" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Background="#1C2433" CornerRadius="14" Padding="18" Margin="18,0,0,0" Opacity="0.96">
                        <StackPanel>
                            <TextBlock Text="Preview details" Foreground="#F4F6FA" FontWeight="SemiBold" FontSize="20" Margin="0,0,0,12" />

                            <Border Height="180" Background="#202B3C" CornerRadius="12" Margin="0,0,0,12">
                                <Grid>
                                    <Image x:Name="PreviewImage" Stretch="UniformToFill" Visibility="Collapsed" />
                                    <TextBlock x:Name="PreviewPlaceholderText" Text="Preview" Foreground="#A8B5CF" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <TextBlock x:Name="PreviewTitle" Text="No wallpaper selected" Foreground="#F4F6FA" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock x:Name="PreviewType" Text="Type: —" Foreground="#D7DEEE" Margin="0,8,0,0" />
                            <TextBlock x:Name="PreviewPath" Text="Path: —" Foreground="#D7DEEE" Margin="0,6,0,0" TextWrapping="Wrap" />
                            <TextBlock x:Name="PreviewStatus" Text="Status: Select a wallpaper" Foreground="#A8B5CF" Margin="0,12,0,0" />
                            <TextBlock x:Name="LastUpdateText" Text="Last update: just now" Foreground="#D7DEEE" Margin="0,12,0,0" />

                            <Button Content="Apply wallpaper" Style="{StaticResource PrimaryButtonStyle}" Click="ApplyWallpaper_Click" Margin="0,18,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
